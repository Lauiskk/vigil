# Every variable here is optional; the defaults are what docker-compose.yml
# uses when the file is absent. Copy to .env only if you need to change one.

# Published ports. Override when something else already holds one — 8080 in
# particular is popular, and a clone that will not start is a clone nobody runs.
GATEWAY_PORT=8080
GENERATOR_PORT=8081
PROCESSOR_PORT_RANGE=8082-8083
CONSOLE_PORT=8090

# info, or debug for per-record detail.
LOG_LEVEL=info
