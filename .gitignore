# Build output
/bin/
/dist/
*.exe

# Terraform working files. The configuration is committed; state is not.
.terraform/
.terraform.lock.hcl
.terraform-artifacts/
*.tfstate
*.tfstate.*
terraform.tfvars

# Test and coverage artefacts
*.out
coverage.html

# Local environment
.env
.env.local

# Captured demo traces are regenerated by `task capture`
/testdata/*.local.jsonl

# Java build output
streams/target/

# Editors
.idea/
.vscode/
*.swp
.DS_Store
